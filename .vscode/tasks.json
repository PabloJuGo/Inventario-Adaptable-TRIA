{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TRIA: ejecutar backend + frontend",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$javac"]
    },
    {
      "label": "TRIA: compilar y probar",
      "type": "shell",
      "command": "mvn clean test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$javac"]
    }
  ]
}
